# Builds the court target applications (GTK/Qt/Slint/X11/Wayland test
# targets) that run inside the VMs. The resulting binaries are copied into
# the disposable VM images.

FROM rust:1.96-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libgtk-3-dev \
        libglib2.0-dev \
        qt6-base-dev \
        cmake \
        ninja-build \
        fonts-dejavu-core \
        ca-certificates \
        gcc \
        linux-libc-dev \
        libsdl2-dev \
    && rm -rf /var/lib/apt/lists/*

ENV DISPLAY="" WAYLAND_DISPLAY="" XDG_RUNTIME_DIR="/tmp" \
    DBUS_SESSION_BUS_ADDRESS="" XAUTHORITY="" SSH_AUTH_SOCK="" RUST_BACKTRACE=1

WORKDIR /targets
CMD ["/bin/bash"]
