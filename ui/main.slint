// main.slint — the Ferrokey OSK root.
//
// Renders the keyboard plus a title/status strip. Window semantics (no-focus
// guarantees) come from ferrokey-surface, never from this file.
//
// The `key-pressed`/`key-released` callbacks are declared here but never
// wired from the .slint side: the Rust pointer bridge (src/main.rs)
// hit-tests raw pointer/touch surface events against the view geometry and
// invokes them directly (rules 18, 85). Slint's TouchArea grabs the pointer
// on press, so per-key callbacks could never deliver chords — the bridge
// owns key semantics; this file only declares the interface.
//
// Terminal workspace mode (Phase 3 addendum #2): the window grows taller,
// the keyboard stays at the top, and the embedded PTY terminal pane renders
// below it as an opaque RGBA image produced by ferrokey-terminal. The
// terminal pane has NO TouchArea: all pane input is routed by the Rust
// terminal-input bridge (src/term_input.rs), so a pane gesture can never
// grab the pointer away from the OSK (§25).

import { Keyboard } from "keyboard.slint";
import { KeyData, LitState } from "key.slint";

export component MainWindow inherits Window {
    in property <bool> degraded: false;
    in property <string> status-line: "";
    in property <bool> status-ok: false;
    in property <string> pending-label: "";
    /// Keys whose caps should stay lit (held / latched / locked modifiers;
    /// driven by Rust from the keyboard state).
    in property <LitState> lit-state: { shift: false, ctrl: false, alt: false, altgr: false, meta: false, fn-key: false, caps: false, num: false };
    in property <bool> text-mode: false;
    in property <[KeyData]> row1: [];
    in property <[KeyData]> row2: [];
    in property <[KeyData]> row3: [];
    in property <[KeyData]> row4: [];
    in property <[KeyData]> row5: [];
    in property <[KeyData]> row6: [];
    in property <[KeyData]> row7: [];
    in property <length> base-width: 58px;
    // Keyboard placement + uniform scale (driven by Rust from the window
    // size; 1.0 = the view's natural size). The window is the fixed title
    // strip (22px) plus the scaled keyboard.
    in property <length> keyboard-x: 0px;
    in property <length> keyboard-width: 920px;
    in property <float> keyboard-scale: 1.0;
    in property <length> key-height: 52px;
    in property <length> min-key-width: 24px;

    // Terminal workspace mode.
    in property <bool> terminal-mode: false;
    /// OSK height (logical px) — the keyboard's scaled height.
    in property <length> keyboard-height: 342px;
    /// Terminal pane height (logical px).
    in property <length> terminal-height: 420px;
    /// The rendered terminal pane (opaque RGBA, physical px).
    in property <image> terminal-image;
    /// Current input destination badge (""SYSTEM"" / ""TERMINAL"").
    in property <string> destination: "SYSTEM";

    callback key-pressed(string);
    callback key-released(string);
    /// Toggle the input destination (SYSTEM ↔ TERMINAL); wired in Rust.
    callback destination-switch();

    // Transparent background: the desktop shows through the gaps between
    // keys (the keys and the title strip are opaque).
    background: transparent;
    title: "Ferrokey";
    no-frame: true;

    Keyboard {
        x: root.keyboard-x;
        y: 22px;
        width: root.keyboard-width;
        height: root.keyboard-height;
        degraded: root.degraded;
        row1: root.row1;
        row2: root.row2;
        row3: root.row3;
        row4: root.row4;
        row5: root.row5;
        row6: root.row6;
        row7: root.row7;
        base-width: root.base-width;
        scale: root.keyboard-scale;
        key-height: root.key-height;
        min-key-width: root.min-key-width;
        lit-state: root.lit-state;
    }

    // Title/status strip — ALWAYS visible. Doubles as the drag handle for
    // the window-gesture layer (src/main.rs, MOVE_BAND), so the OSK reads as
    // a normal window: grab it to move. It is a fixed strip ABOVE the
    // keyboard (the keyboard starts at y=22), so nothing is ever cropped.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 22px;
        background: #14171c;
        Text {
            x: 10px;
            width: 110px;
            height: 22px;
            vertical-alignment: center;
            text: "Ferrokey";
            color: #8b949e;
            font-size: 11px;
            font-weight: 700;
        }
        Text {
            x: 0px;
            width: root.width;
            height: 22px;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: root.status-line;
            color: root.status-ok ? #7ee787 : #e06c75;
            font-size: 11px;
        }
        // Bottom border separating the strip from the keyboard.
        Rectangle {
            x: 0px;
            y: 21px;
            width: root.width;
            height: 1px;
            background: #2a3038;
        }
    }

    // The embedded terminal pane (image-only; input is routed by Rust).
    if root.terminal-mode: Rectangle {
        y: 22px + root.keyboard-height;
        width: root.width;
        height: root.terminal-height;
        background: #111418;
        Image {
            width: root.width;
            height: root.terminal-height;
            source: root.terminal-image;
            image-rendering: pixelated;
        }
        // Thin separator between the OSK and the terminal.
        Rectangle {
            y: 0px;
            width: root.width;
            height: 1px;
            background: #3a4049;
        }
    }

    // Destination badge (always visible in terminal mode). Tapping it
    // switches the input destination — a standalone button, so its TouchArea
    // may grab the pointer (§112).
    if root.terminal-mode: TouchArea {
        x: root.width - 92px;
        y: 22px + root.keyboard-height + 4px;
        width: 84px;
        height: 18px;
        clicked => { root.destination-switch(); }
        Rectangle {
            width: 84px;
            height: 18px;
            border-radius: 4px;
            background: root.destination == "TERMINAL" ? #1c3a2a : #26303a;
            border-width: 1px;
            border-color: root.destination == "TERMINAL" ? #3f8a5c : #3a6ea5;
            Text {
                text: root.destination;
                color: root.destination == "TERMINAL" ? #8ef0b0 : #8ecbff;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Resize grip (bottom-right corner) — visual only; the gesture is
    // hit-tested by the Rust window-gesture layer (RESIZE_CORNER). Always
    // visible: in terminal mode it overlays the terminal pane's corner, which
    // is exactly where the resize gesture lives.
    Rectangle {
        x: root.width - 16px;
        y: root.height - 16px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: #3a4049;
    }

    // Compose-state hint. Deliberately an OVERLAY (not a layout child): the
    // key geometry must never shift when a dead key is pending, or pointer
    // targeting (and the courts' fixed key coordinates) would break.
    if root.pending-label != "": Rectangle {
        x: (root.width - 220px) / 2;
        y: 24px;
        width: 220px;
        height: 22px;
        background: #26303a;
        border-radius: 6px;
        border-width: 1px;
        border-color: #3a6ea5;
        Text {
            text: root.pending-label;
            color: #8ecbff;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
