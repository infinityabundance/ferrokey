// keyboard.slint — the OSK itself: seven physical rows driven by data models.
//
// The row contents (which physical keys, what labels, what widths) are
// provided from Rust, derived from the active keyboard *view* (compact /
// full desktop) and the active layout. This file contains zero
// window/compositor policy — it only renders.
//
// `base-width` is the view's base key width; each KeyData.width is a factor
// of it, so the same component tree renders every view without recompiling
// the UI.
//
// Key semantics (which key is down/up) do NOT flow through this file: the
// Rust pointer bridge (src/main.rs) hit-tests raw pointer/touch surface
// events against the view geometry and drives key-pressed/key-released
// directly (rules 18, 85). Each Key's TouchArea only lights the cap.

import { Key, KeyData, LitState } from "key.slint";

component KeyRow inherits HorizontalLayout {
    in property <[KeyData]> keys: [];
    in property <length> base-width: 58px;
    in property <length> key-height: 52px;
    in property <length> min-key-width: 24px;
    in property <float> scale: 1.0;
    in property <LitState> lit-state: { shift: false, ctrl: false, alt: false, altgr: false, meta: false, fn-key: false, caps: false, num: false };

    spacing: 6px * root.scale;

    for k in keys: Key {
        key-data: k;
        base-width: root.base-width;
        key-height: root.key-height;
        min-key-width: root.min-key-width;
        label-scale: root.scale;
        lit-state: root.lit-state;
    }
}

export component Keyboard inherits Rectangle {
    in property <[KeyData]> row1: [];
    in property <[KeyData]> row2: [];
    in property <[KeyData]> row3: [];
    in property <[KeyData]> row4: [];
    in property <[KeyData]> row5: [];
    in property <[KeyData]> row6: [];
    in property <[KeyData]> row7: [];
    in property <bool> degraded: false;
    in property <length> base-width: 58px;
    /// Uniform keyboard scale (1.0 = the view's natural size): key heights,
    /// minimum widths, spacing and padding all scale with it, so the OSK
    /// grows and shrinks with the window while the key grid stays aligned
    /// with the Rust hit-testing (which maps through the same scale).
    in property <float> scale: 1.0;
    in property <length> key-height: 52px;
    in property <length> min-key-width: 24px;
    /// Which modifier caps stay lit (held / latched / locked).
    in property <LitState> lit-state: { shift: false, ctrl: false, alt: false, altgr: false, meta: false, fn-key: false, caps: false, num: false };

    background: transparent;

    VerticalLayout {
        padding: 6px * root.scale;
        spacing: 6px * root.scale;

        KeyRow { keys: row1; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
        KeyRow { keys: row2; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
        KeyRow { keys: row3; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
        KeyRow { keys: row4; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
        KeyRow { keys: row5; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
        KeyRow { keys: row6; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
        KeyRow { keys: row7; base-width: root.base-width; key-height: root.key-height; min-key-width: root.min-key-width; scale: root.scale; lit-state: root.lit-state; }
    }

    if root.degraded: Rectangle {
        height: 22px;
        border-radius: 6px;
        background: #54381f;
        Text {
            text: "degraded mode: focus preservation unavailable";
            color: #ffd9b3;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
